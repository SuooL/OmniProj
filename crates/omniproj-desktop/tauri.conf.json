{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniProj",
  "version": "0.0.1",
  "identifier": "app.omniproj.desktop",
  "build": {
    "frontendDist": "web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "web" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "web" }
  },
  "app": {
    "windows": [
      {
        "title": "OmniProj",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
